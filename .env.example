# Example environment configuration. Copy values into your real (gitignored) env
# files (env/.env.local, ./.env). Do NOT put real secrets in this example file.

# --- Security trimming (Phase 2) ---
# When true, the indexer captures SharePoint ACLs and every AI Search query is
# filtered to documents the requesting user may access. Leave false until verified.
ENABLE_SECURITY_TRIMMING=false

# One-shot full re-index (set true once to backfill ACLs after enabling trimming,
# then set back to false). Checksums live in the index, so this is the equivalent
# of clearing the checksum cache.
SHAREPOINT_FORCE_REINDEX=false
