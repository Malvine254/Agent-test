# Example environment configuration. Copy values into your real (gitignored) env
# files (env/.env.local, ./.env). Do NOT put real secrets in this example file.

# --- Azure AI Search keys (Phase 4) ---
# The retriever (reads) uses the QUERY-only key; the indexer (writes/index management)
# uses the ADMIN key. Create a query-only key in the Azure Portal — do NOT reuse the
# admin key here in production.
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_ADMIN_KEY=

# --- Secret management (Phase 4) ---
# Set this in deployed environments (App Service / Container) to load secrets from
# Azure Key Vault at startup. Leave EMPTY for local dev — secrets come from this file.
# Assign the app's managed identity the "Key Vault Secrets User" role on the vault.
AZURE_KEY_VAULT_URL=

# --- Security trimming (Phase 2) ---
# When true, the indexer captures SharePoint ACLs and every AI Search query is
# filtered to documents the requesting user may access. Leave false until verified.
ENABLE_SECURITY_TRIMMING=false

# --- Conversation memory (Phase 3) ---
# Number of recent turns kept in conversation memory (1 turn = 2 messages).
MAX_MEMORY_TURNS=5
# Durable conversation store. When set, uses Azure Table Storage; otherwise falls
# back to a local JSON file (fine for single-instance/dev, not for multi-instance).
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# Max documents discovered + indexed per run. MUST be high enough to cover the whole
# corpus. If too low (e.g. the old default of 200), later documents are never indexed —
# and with security trimming on, those unindexed chunks are hidden from everyone.
SHAREPOINT_INDEX_MAX_ITEMS_PER_RUN=2000

# One-shot full re-index (set true once to backfill ACLs after enabling trimming,
# then set back to false). Checksums live in the index, so this is the equivalent
# of clearing the checksum cache.
SHAREPOINT_FORCE_REINDEX=false
