{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.24/MicrosoftTeams.schema.json",
    "manifestVersion": "1.24",
    "version": "1.1.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "Armely",
        "websiteUrl": "https://dynamocapital.com/",
        "privacyUrl": "https://dynamocapital.com/privacy",
        "termsOfUseUrl": "https://dynamocapital.com/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Dynamo Capital assistant",
        "full": "Dynamo Capital assistant"
    },
    "description": {
        "short": "Dynamo Capital assistant - Your AI-powered assistant",
        "full": "Dynamo Capital assistant is an advanced AI-powered assistant designed for internal team collaboration and productivity. Analyze documents, search SharePoint content through Azure AI Search, and get intelligent responses. Supports file uploads up to 20MB including PDF, Word, Excel, PowerPoint, and more."
    },
    "accentColor": "#FFFFFF",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "team",
                "groupChat",
                "personal"
            ],
            "supportsFiles": true,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": [
                        "personal"
                    ],
                    "commands": [
                        {
                            "title": "How can you help me?",
                            "description": "Learn about Dynamo capital AI's capabilities and features"
                        },
                        {
                            "title": "Search documents",
                            "description": "Search SharePoint documents indexed in Azure AI Search"
                        },
                        {
                            "title": "Analyze files",
                            "description": "Upload and analyze documents, spreadsheets, and other files"
                        }
                    ]
                },
                {
                    "scopes": [
                        "team",
                        "groupChat"
                    ],
                    "commands": [
                        {
                            "title": "Help",
                            "description": "Learn how to use this bot in groups and channels"
                        },
                        {
                            "title": "Search documents",
                            "description": "Search team documents indexed in Azure AI Search"
                        },
                        {
                            "title": "Analyze files",
                            "description": "Upload and analyze team documents"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "${{BOT_DOMAIN}}"
    ],
    "webApplicationInfo": {
        "id": "${{BOT_ID}}",
        "resource": "api://botid-${{BOT_ID}}"
    }
}
