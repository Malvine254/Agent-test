      "value": "${{FLUX_API_KEY}}"
    },
    "imageFluxDeployment": {
      "value": "${{FLUX_DEPLOYMENT}}"
    },
    "imageFluxApiVersion": {
      "value": "${{FLUX_API_VERSION}}"
    },
